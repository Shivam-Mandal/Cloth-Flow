NODE_ENV=development
PORT=5000
DATABASE_URI=mongodb://localhost:27017/clothflow
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRESIn=15m
REFRESH_TOKEN_EXPIRESIn=7d
CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_UPLOAD_FOLDER=clothflow/styles
CLOUDINARY_MAX_FILE_SIZE_BYTES=5242880
CLOUDINARY_MAX_FILE_COUNT=5
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM_EMAIL=no-reply@example.com
